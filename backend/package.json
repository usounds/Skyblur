{
  "name": "skyblurapi",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --minify",
    "deploy:preview": "wrangler deploy --env preview --minify",
    "gen-lex": "lex-cli generate",
    "update": "pnpm dlx npm-check-updates -u --reject \"prisma,@prisma/client\" && pnpm install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/client": "^5.1.2",
    "@atcute/identity-resolver": "^2.0.3",
    "@atcute/lexicons": "^2.1.1",
    "@atcute/oauth-crypto": "^1.0.1",
    "@atcute/oauth-node-client": "^2.0.1",
    "did-jwt": "^9.0.2",
    "did-resolver": "^6.0.0",
    "hono": "4.13.13",
    "web-did-resolver": "^3.2.0"
  },
  "devDependencies": {
    "@atcute/bluesky": "4.0.24",
    "@atcute/lex-cli": "^3.3.0",
    "@cloudflare/unenv-preset": "^2.16.2",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "unenv": "2.0.0-rc.24",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@cloudflare/workerd-darwin-arm64",
      "esbuild",
      "workerd"
    ]
  }
}
