{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skyblurapi",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"APPVIEW_HOST": "dev.skyblur.uk",
		"API_HOST": "devapi.skyblur.uk",
		"PDS_READ_THROUGH_CACHE": "false"
	},
	"kv_namespaces": [
		{
			"binding": "SKYBLUR_KV_CACHE",
			"id": "56a373ab2112453693aeb18c78af7e07"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SKYBLUR_DO",
				"class_name": "OAuthStoreDO"
			},
			{
				"name": "SKYBLUR_DO_RESTRICTED",
				"class_name": "RestrictedPostDO"
			},
			{
				"name": "SKYBLUR_DO_POST_MIRROR",
				"class_name": "PostMirrorDO"
			},
			{
				"name": "SKYBLUR_DO_JETSTREAM_INGEST",
				"class_name": "JetstreamIngestDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"OAuthStoreDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"RestrictedPostDO"
			]
		},
		{
			"tag": "v3"
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["PostMirrorDO"]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["JetstreamIngestDO"]
		}
	],
	"env": {
		"preview": {
			"vars": {
				"APPVIEW_HOST": "preview.skyblur.uk",
				"API_HOST": "previewapi.skyblur.uk",
				"PDS_READ_THROUGH_CACHE": "false"
			},
			"kv_namespaces": [
				{
					"binding": "SKYBLUR_KV_CACHE",
					"id": "56a373ab2112453693aeb18c78af7e07"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SKYBLUR_DO",
						"class_name": "OAuthStoreDO"
					},
					{
						"name": "SKYBLUR_DO_RESTRICTED",
						"class_name": "RestrictedPostDO"
					},
					{
						"name": "SKYBLUR_DO_POST_MIRROR",
						"class_name": "PostMirrorDO"
					},
					{
						"name": "SKYBLUR_DO_JETSTREAM_INGEST",
						"class_name": "JetstreamIngestDO"
					}
				]
			},
			"routes": [
				{
					"pattern": "previewapi.skyblur.uk",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1.0
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"OAuthStoreDO"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"RestrictedPostDO"
					]
				},
				{
					"tag": "v3"
				},
				{
					"tag": "v4",
					"new_sqlite_classes": ["PostMirrorDO"]
				},
				{
					"tag": "v5",
					"new_sqlite_classes": ["JetstreamIngestDO"]
				}
			],
			"r2_buckets": [
				{
					"binding": "SKYBLUR_BACKUP",
					"bucket_name": "skyblur-preview-backup"
				}
			]
		},
		"production": {
			"vars": {
				"APPVIEW_HOST": "skyblur.uk",
				"API_HOST": "api.skyblur.uk",
				"PDS_READ_THROUGH_CACHE": "true"
			},
			"kv_namespaces": [
				{
					"binding": "SKYBLUR_KV_CACHE",
					"id": "a29848660cb649cf8ebaffced3041ea0"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SKYBLUR_DO",
						"class_name": "OAuthStoreDO"
					},
					{
						"name": "SKYBLUR_DO_RESTRICTED",
						"class_name": "RestrictedPostDO"
					},
					{
						"name": "SKYBLUR_DO_POST_MIRROR",
						"class_name": "PostMirrorDO"
					},
					{
						"name": "SKYBLUR_DO_JETSTREAM_INGEST",
						"class_name": "JetstreamIngestDO"
					}
				]
			},
			"routes": [
				{
					"pattern": "api.skyblur.uk",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 0.3
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"OAuthStoreDO"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"RestrictedPostDO"
					]
				},
				{
					"tag": "v3"
				},
				{
					"tag": "v4",
					"new_sqlite_classes": ["PostMirrorDO"]
				},
				{
					"tag": "v5",
					"new_sqlite_classes": ["JetstreamIngestDO"]
				}
			],
			"r2_buckets": [
				{
					"binding": "SKYBLUR_BACKUP",
					"bucket_name": "skyblur-backup"
				}
			],
			"triggers": {
				"crons": [
					"0 0 * * *"
				]
			}
		}
	},
	"r2_buckets": [
		{
			"binding": "SKYBLUR_BACKUP",
			"bucket_name": "skyblur-preview-backup"
		}
	]
}
